# ---------------------------------------------------------------------------
# Local development
#
#   supabase start
#
# prints these values. The local anon/service-role keys below are the standard
# Supabase demo keys — identical on every local install, and not secrets.
# ---------------------------------------------------------------------------

# Local: the port printed by `supabase start` (54322).
# Production: Supabase's Supavisor TRANSACTION pooler on port 6543, not 5432.
#   Serverless functions exhaust connections on the direct port.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# MapTiler key for zh-Hant vector basemap labels. Optional — falls back to a
# keyless CARTO dark raster basemap. Restrict the key to your domains.
NEXT_PUBLIC_MAPTILER_KEY=

# Cloudflare Turnstile. Both unset locally = challenge skipped, form still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Authenticates the classification worker at /api/jobs/classify, which Vercel Cron
# calls. REQUIRED IN PRODUCTION. Left empty the endpoint refuses every request, so
# reports are submitted and held but never identified — it fails safe, silently.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Shared secret for the Modal inference endpoint (M3).
ML_ENDPOINT_URL=
ML_ENDPOINT_TOKEN=

# Register the service worker in development too. Off by default: a stale cache
# is confusing while editing pages. e2e/offline.spec.mjs does not need this — it
# registers /sw.js itself — so set it only to exercise offline mode by hand.
NEXT_PUBLIC_SW_IN_DEV=
