node_modules/
.next/
out/
dist/
# Every env file except the committed template. `.env` and `.env.local` alone
# left `.env.production.local` — where `vercel env pull` puts a production pull,
# and one of the four files Next.js loads by itself — untracked but not ignored,
# so `git add -A` would commit the production database password to a public repo.
.env*
!.env.example
*.log
.DS_Store
.turbo/
data/cache/
*.tsbuildinfo

# Generated: 109 MB embedding matrix, downloaded eval images, DB dumps
data/
.backup/
# Vendored at build time by `npm run sync:maplibre` (predev/prebuild)
apps/web/public/maplibre/

# Python virtualenv for apps/ml. Recreated with `python -m venv .venv` and
# requirements.txt — it is machine-specific, ~1 GB, and contains a 322 MB torch
# binary that GitHub rejects outright (100 MB per-file hard limit).
.venv/
__pycache__/
*.pyc

# Supabase CLI local state, not project source.
supabase/.temp/
supabase/.branches/


# Design-review screenshots (apps/web/e2e/_shots.mjs)
apps/web/e2e/shots/

# Vercel CLI project link (org/project ids)
.vercel
