# Python virtualenv for apps/ml. Recreated with `python -m venv .venv` and
# requirements.txt — it is machine-specific, ~1 GB, and contains a 322 MB torch
# binary that GitHub rejects outright (100 MB per-file hard limit).
.venv/
__pycache__/
*.pyc

# Supabase CLI local state, not project source.
supabase/.temp/
supabase/.branches/


# Review gallery and the map spec's screenshot: output, not source.
#
# apps/web/e2e/shots.mjs writes a few hundred PNGs and an index.html here on
# every run, and map.spec.mjs overwrites map-render.png on every run. The PNG
# used to be committed — 228 KB of binary rewritten by six commits and compared
# against nothing. CI uploads both as artifacts, which is what a screenshot
# nobody diffs is actually for.
apps/web/e2e/shots/
apps/web/e2e/map-render.png

# Vercel CLI project link (org/project ids)
.vercel
