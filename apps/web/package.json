{
  "name": "@conservation/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sync:maplibre": "mkdir -p public/maplibre && cp ../../node_modules/maplibre-gl/dist/maplibre-gl.mjs ../../node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs ../../node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre/",
    "predev": "npm run sync:maplibre",
    "prebuild": "npm run sync:maplibre",
    "test:map": "node e2e/map.spec.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:offline": "node e2e/offline.spec.mjs",
    "test:e2e": "npm run test:map && npm run test:offline && npm run test:focus",
    "lint": "eslint .",
    "test:pages": "node e2e/pages.spec.mjs",
    "test:focus": "node e2e/focus.spec.mjs"
  },
  "dependencies": {
    "@conservation/shared": "*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/analytics": "^2.0.1",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "maplibre-gl": "^6.1.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "pbf": "^5.1.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wait-on": "^9.1.0"
  }
}
