# Mapbox GL, for the map tiles.
VITE_MAPBOX_TOKEN=

# Supabase project. The publishable (anon) key is meant to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The shared account reports are inserted as.
#
# These reach the browser: Vite inlines every VITE_* variable into the bundle,
# so this password is readable by any visitor. Keeping it here rather than in
# source only keeps it out of git. Treat this account as compromised by design
# and give it the narrowest possible rights — insert on `reports`, nothing else.
VITE_REPORTER_EMAIL=
VITE_REPORTER_PASSWORD=
